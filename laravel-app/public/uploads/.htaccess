# Harden public/uploads directory against script execution and MIME sniffing
Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(?i:php[0-9]?|phtml|phar|pht|shtml|html?|svgz?|js|mjs|cjs|pl|py|cgi|sh|exe|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
