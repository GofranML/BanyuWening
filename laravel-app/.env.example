APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# BanyuWening Machine Learning Engine Configuration
ML_PYTHON_PATH=python3

# BanyuWening MQTT Broker Configuration
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=

# BanyuWening Multi-Protocol WebSocket & HTTP Fallback Configuration
WS_HOST=0.0.0.0
WS_PORT=8081
WS_PUBLIC_URL=ws://127.0.0.1:8081
HTTP_FALLBACK_POLL_MS=5000
WS_CONNECT_TIMEOUT_MS=3000

# BanyuWening Secure File Upload Pipeline
UPLOAD_SCANNER_DRIVER=clamav
UPLOAD_SCAN_ASYNC=false
UPLOAD_RATE_LIMIT_PER_MINUTE=30
UPLOAD_MAX_REQUEST_BYTES=57671680
UPLOAD_QUARANTINE_TTL_MINUTES=60
UPLOAD_QUARANTINE_RETAIN_INFECTED=true
UPLOAD_QUARANTINE_MAX_BYTES=524288000
UPLOAD_SCANNER_TIMEOUT=30
UPLOAD_SCANNER_MAX_BYTES=52428800
UPLOAD_FIRMWARE_REQUIRE_ESP32_MAGIC=false
CLAMAV_MODE=auto
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SOCKET=
CLAMAV_BINARY=clamdscan
CLAMAV_FALLBACK_BINARY=clamscan

