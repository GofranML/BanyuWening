        <mxCell id="hdr4" value="&lt;b style=&#39;font-size: 15px;&#39;&gt;LAMPIRAN STANDAR FLOWCHART &amp;amp; SPESIFIKASI SISTEM BANYUWENING&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size: 11px; color: #475569;&#39;&gt;Rujukan Standar Simbol Diagram Alir (ANSI X3.5 / ISO 5807), Matriks Ambang Batas Sensorik &amp;amp; Alokasi Pinout ESP32&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" vertex="1" parent="1">
