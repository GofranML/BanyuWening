        <mxCell id="12" value="Display" style="shape=display;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#312E81;fontSize=10;" vertex="1" parent="1">
