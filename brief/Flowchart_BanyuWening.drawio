        </mxCell>
        <mxCell id="13" value="&lt;b style=&#39;color: #0F172A; font-size: 11px;&#39;&gt;Display (Tampilan Monitor/Layar)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color: #475569; font-size: 10px;&#39;&gt;Tampilan layar monitor: LCD 16x2 I2C, Web Dashboard Next.js, Telegram.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="165" y="361" width="390" height="42" as="geometry" />
