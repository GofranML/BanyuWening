        <mxCell id="16" value="Dokumen" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#92400E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="461" width="90" height="34" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b style=&#39;color: #0F172A; font-size: 11px;&#39;&gt;Dokumen (Laporan Cetak)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color: #475569; font-size: 10px;&#39;&gt;Dokumen fisik: lembar log kalibrasi sensor pH &amp; laporan cetak PDF/Excel.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="165" y="457" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="18" value="Stored" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.5;fontColor=#14532D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="509" width="90" height="34" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;b style=&#39;color: #0F172A; font-size: 11px;&#39;&gt;Stored Data (Basis Data)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color: #475569; font-size: 10px;&#39;&gt;Penyimpanan persisten pada Supabase PostgreSQL &amp; EEPROM ESP32.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="165" y="505" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="20" value="Preparation" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="557" width="90" height="34" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b style=&#39;color: #0F172A; font-size: 11px;&#39;&gt;Preparation (Inisialisasi Nilai)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color: #475569; font-size: 10px;&#39;&gt;Pemberian nilai awal variabel, konfigurasi baudrate 115200 &amp; pinout GPIO.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="165" y="553" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="22" value="On-Page" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1.5;fontColor=#0F172A;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="605" width="90" height="34" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b style=&#39;color: #0F172A; font-size: 11px;&#39;&gt;On-Page Connector (A, B, C)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color: #475569; font-size: 10px;&#39;&gt;Penghubung alur pada halaman yang sama tanpa memotong garis.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="165" y="601" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="24" value="Off-Page" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1E40AF;strokeWidth=1.5;fontColor=#1E40AF;fontStyle=1;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="653" width="90" height="34" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b style=&#39;color: #0F172A; font-size: 11px;&#39;&gt;Off-Page Connector&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color: #475569; font-size: 10px;&#39;&gt;Penghubung alur antar halaman yang berbeda (Pentagon runcing ke bawah).&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="165" y="649" width="390" height="42" as="geometry" />
        </mxCell>
        <mxCell id="grp_mat" value="&lt;b style=&#39;font-size: 13px;&#39;&gt;2. MATRIKS AMBANG BATAS KUALITAS AIR KOLAM LELE (SRS)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;horizontal=1;collapsible=0;dropTarget=0;fillColor=#065F46;strokeColor=#CBD5E1;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="80" width="530" height="340" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;b style=&#39;font-size: 11px; color: #0F172A;&#39;&gt;Derajat Keasaman (pH)&lt;/b&gt; &lt;span style=&#39;color: #64748B; font-size: 10px;&#39;&gt;(Modul PH-4502C + Probe Kaca)&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #047857; font-size: 10px;&#39;&gt;• Rentang Ideal: &lt;b&gt;6.5 - 8.5 pH (Netral / Sehat)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #B91C1C; font-size: 10px;&#39;&gt;• Kondisi Kritis: &lt;b&gt;&amp;lt; 6.0 (Asam) atau &amp;gt; 8.8 (Basa)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #1E40AF; font-size: 10px;&#39;&gt;• Aksi Sistem: &lt;b&gt;Aktifkan Aerator DC 12V &amp;amp; Telegram Alert&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="605" y="125" width="500" height="58" as="geometry" />
        </mxCell>
        <mxCell id="27" value="&lt;b style=&#39;font-size: 11px; color: #0F172A;&#39;&gt;Suhu Air Kolam&lt;/b&gt; &lt;span style=&#39;color: #64748B; font-size: 10px;&#39;&gt;(Sensor Digital DS18B20 (1-Wire))&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #047857; font-size: 10px;&#39;&gt;• Rentang Ideal: &lt;b&gt;26.0 - 32.0 °C (Metabolisme Normal)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #B91C1C; font-size: 10px;&#39;&gt;• Kondisi Kritis: &lt;b&gt;&amp;gt; 33.0 °C (Panas) atau &amp;lt; 22.0 °C&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #1E40AF; font-size: 10px;&#39;&gt;• Aksi Sistem: &lt;b&gt;Nyalakan Aerator Darurat Sirkulasi Suhu&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="605" y="189" width="500" height="58" as="geometry" />
        </mxCell>
        <mxCell id="28" value="&lt;b style=&#39;font-size: 11px; color: #0F172A;&#39;&gt;Total Dissolved Solids&lt;/b&gt; &lt;span style=&#39;color: #64748B; font-size: 10px;&#39;&gt;(Analog TDS Meter (Konduktivitas))&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #047857; font-size: 10px;&#39;&gt;• Rentang Ideal: &lt;b&gt;&amp;lt; 400 ppm (Kelarutan Bersih)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #B91C1C; font-size: 10px;&#39;&gt;• Kondisi Kritis: &lt;b&gt;&amp;gt; 800 ppm (Pembusukan Pakan)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #1E40AF; font-size: 10px;&#39;&gt;• Aksi Sistem: &lt;b&gt;Peringatan Dini Kualitas Air &amp;amp; Ganti Air&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="605" y="253" width="500" height="58" as="geometry" />
        </mxCell>
        <mxCell id="29" value="&lt;b style=&#39;font-size: 11px; color: #0F172A;&#39;&gt;Kekeruhan (Turbiditas)&lt;/b&gt; &lt;span style=&#39;color: #64748B; font-size: 10px;&#39;&gt;(Turbidity Sensor Optik Analog)&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #047857; font-size: 10px;&#39;&gt;• Rentang Ideal: &lt;b&gt;&amp;lt; 50 NTU (Air Kolam Sehat)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #B91C1C; font-size: 10px;&#39;&gt;• Kondisi Kritis: &lt;b&gt;&amp;gt; 120 NTU (Pepekatan Lumpur)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #1E40AF; font-size: 10px;&#39;&gt;• Aksi Sistem: &lt;b&gt;Evaluasi Slope Laju Peningkatan Lumpur&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="605" y="317" width="500" height="58" as="geometry" />
        </mxCell>
        <mxCell id="30" value="&lt;b style=&#39;font-size: 11px; color: #0F172A;&#39;&gt;Ketinggian Air Kolam&lt;/b&gt; &lt;span style=&#39;color: #64748B; font-size: 10px;&#39;&gt;(Float Switch Kontak Kering)&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #047857; font-size: 10px;&#39;&gt;• Rentang Ideal: &lt;b&gt;Terapung / Normal (Taraf Cukup)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #B91C1C; font-size: 10px;&#39;&gt;• Kondisi Kritis: &lt;b&gt;Tenggelam (Volume di Bawah Min)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color: #1E40AF; font-size: 10px;&#39;&gt;• Aksi Sistem: &lt;b&gt;Alert Water Level Low &amp;amp; Petambak Isi Air&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="605" y="381" width="500" height="58" as="geometry" />
        </mxCell>
        <mxCell id="grp_pin" value="&lt;b style=&#39;font-size: 13px;&#39;&gt;3. SPESIFIKASI ALOKASI PINOUT ESP32 &amp; INFRASTRUKTUR CLOUD&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;horizontal=1;collapsible=0;dropTarget=0;fillColor=#1E40AF;strokeColor=#CBD5E1;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="440" width="530" height="350" as="geometry" />
        </mxCell>
        <mxCell id="31" value="&lt;b style=&#39;font-size: 10.5px; color: #0F172A;&#39;&gt;• Sensor pH Analog PH-4502C&lt;/b&gt; &lt;span style=&#39;color: #1E40AF; font-weight: bold;&#39;&gt;[GPIO 34 (ADC1_CH6)]&lt;/span&gt;: &lt;span style=&#39;color: #475569; font-size: 9.5px;&#39;&gt;Analog 0-3.3V, sampling 10x, kalibrasi buffer 4 &amp;amp; 7&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="605" y="485" width="500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="32" value="&lt;b style=&#39;font-size: 10.5px; color: #0F172A;&#39;&gt;• Sensor Suhu Air DS18B20&lt;/b&gt; &lt;span style=&#39;color: #1E40AF; font-weight: bold;&#39;&gt;[GPIO 4 (Digital 1-Wire)]&lt;/span&gt;: &lt;span style=&#39;color: #475569; font-size: 9.5px;&#39;&gt;Resolusi 12-bit waterproof probe, pull-up 4.7kΩ&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="605" y="517" width="500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="33" value="&lt;b style=&#39;font-size: 10.5px; color: #0F172A;&#39;&gt;• Sensor TDS Meter Analog&lt;/b&gt; &lt;span style=&#39;color: #1E40AF; font-weight: bold;&#39;&gt;[GPIO 35 (ADC1_CH7)]&lt;/span&gt;: &lt;span style=&#39;color: #475569; font-size: 9.5px;&#39;&gt;Analog voltage divider konversi ke ppm zat terlarut&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="605" y="549" width="500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="34" value="&lt;b style=&#39;font-size: 10.5px; color: #0F172A;&#39;&gt;• Sensor Turbiditas Optik&lt;/b&gt; &lt;span style=&#39;color: #1E40AF; font-weight: bold;&#39;&gt;[GPIO 32 (ADC1_CH4)]&lt;/span&gt;: &lt;span style=&#39;color: #475569; font-size: 9.5px;&#39;&gt;Analog transduser transmisi cahaya fototransistor&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="605" y="581" width="500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="35" value="&lt;b style=&#39;font-size: 10.5px; color: #0F172A;&#39;&gt;• Float Switch Water Level&lt;/b&gt; &lt;span style=&#39;color: #1E40AF; font-weight: bold;&#39;&gt;[GPIO 18 (Input Pull-Up)]&lt;/span&gt;: &lt;span style=&#39;color: #475569; font-size: 9.5px;&#39;&gt;Dry contact switch deteksi ambang batas minimum kolam&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="605" y="613" width="500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="36" value="&lt;b style=&#39;font-size: 10.5px; color: #0F172A;&#39;&gt;• Modul Relay 2-Channel 5V&lt;/b&gt; &lt;span style=&#39;color: #1E40AF; font-weight: bold;&#39;&gt;[GPIO 25 &amp;amp; GPIO 26]&lt;/span&gt;: &lt;span style=&#39;color: #475569; font-size: 9.5px;&#39;&gt;Kontrol Aerator DC 12V 5A &amp;amp; cadangan pompa sirkulasi&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="605" y="645" width="500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="37" value="&lt;b style=&#39;font-size: 10.5px; color: #0F172A;&#39;&gt;• Layar LCD 16x2 I2C Display&lt;/b&gt; &lt;span style=&#39;color: #1E40AF; font-weight: bold;&#39;&gt;[GPIO 21 (SDA) / 22 (SCL)]&lt;/span&gt;: &lt;span style=&#39;color: #475569; font-size: 9.5px;&#39;&gt;Display lokal telemetri tepi kolam &amp;amp; status WiFi/MQTT&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="605" y="677" width="500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="38" value="&lt;b style=&#39;font-size: 10.5px; color: #0F172A;&#39;&gt;• Infrastruktur Cloud &amp;amp; DB&lt;/b&gt; &lt;span style=&#39;color: #1E40AF; font-weight: bold;&#39;&gt;[HiveMQ Cloud / FastAPI]&lt;/span&gt;: &lt;span style=&#39;color: #475569; font-size: 9.5px;&#39;&gt;MQTT TLS 8883, REST API Render, PostgreSQL Supabase&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="605" y="709" width="500" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
