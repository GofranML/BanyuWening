          <mxGeometry x="60" y="413" width="90" height="34" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b style=&#39;color: #0F172A; font-size: 11px;&#39;&gt;Call (Memanggil Subprogram)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color: #475569; font-size: 10px;&#39;&gt;Pemanggilan rutin modular: Routine_Offline_Failsafe(), XGBoost Predict.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="165" y="409" width="390" height="42" as="geometry" />
